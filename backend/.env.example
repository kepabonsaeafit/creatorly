# Author: Felipe Gómez
# Template for backend/.env — copy it (`cp .env.example .env`) and fill in real values.

# HTTP server
PORT=3000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (also used by docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=creatorly
DB_PASSWORD=change-me
DB_NAME=creatorly

# Secret used to sign login tokens (JWT); use a long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
