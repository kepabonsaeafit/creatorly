# Author: Felipe Gómez
# Template of the backend environment variables. Every one is optional in
# development (the defaults below are what the code uses when it is unset).
# Copy it to .env (ignored by git) only if you need to change something, and
# load it with: node --env-file=.env dist/main.js
# In production (docker-compose.yml) these values come from deploy.sh.

# port the API listens on
PORT=3000

# path of the SQLite database file (created and seeded on first start)
SQLITE_PATH=database.sqlite

# comma-separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://localhost,http://127.0.0.1

# secret that signs the JWT access tokens; production MUST use a long random
# value (deploy.sh generates one). Never commit the real value.
JWT_SECRET=change-me-to-a-long-random-value
